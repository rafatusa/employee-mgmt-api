# Local development configuration. Copy to .env and fill in real values.
# In AWS these values are delivered by the CI pipeline from repository secrets
# and written to /opt/employee-api/.env by Puppet — never committed.

DATABASE_NAME=employeedb
DATABASE_USERNAME=employee
DATABASE_PASSWORD=
DATABASE_URL=jdbc:postgresql://localhost:5432/employeedb

# HMAC signing key for JWTs - minimum 32 characters, alphanumeric.
JWT_SECRET=
JWT_TTL_SECONDS=3600

# Seeded administrator account used to obtain the first token.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

SERVER_PORT=8080
