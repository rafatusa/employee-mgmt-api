<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- JPA entities intentionally expose mutable date/decimal fields through accessors. -->
  <Match>
    <Class name="~com\.udap\.employee\.domain\..*"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!-- Spring injects singleton collaborators; storing the reference is the framework contract. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Class name="~com\.udap\.employee\.(service|security|web|config)\..*"/>
  </Match>

  <!-- Records generated by the compiler are not our code to fix. -->
  <Match>
    <Class name="~com\.udap\.employee\.dto\..*"/>
  </Match>
</FindBugsFilter>
